          }
        }
      ]
    },
    {
      "name": "📊 Dashboard",
      "description": "Métricas y estadísticas del dashboard",
      "item": [
        {
          "name": "Obtener Métricas",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/dashboard/metrics",
