{
  "info": {
    "name": "Workflow Engine API",
    "description": "Colección completa de endpoints del sistema de gestión de workflows. Spring Boot + MongoDB.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "workflow-demo",
    "_exporter_name": "Workflow Engine"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "workflowId",
      "value": "65f1a2b3c4d5e6f7890a3001",
      "type": "string"
    },
    {
      "key": "processInstanceId",
      "value": "65f1a2b3c4d5e6f7890a5001",
      "type": "string"
    },
    {
      "key": "actividadId",
      "value": "act-001",
      "type": "string"
    },
    {
      "key": "collaboratorId",
      "value": "65f1a2b3c4d5e6f7890a4001",
      "type": "string"
    },
    {
      "key": "notificationId",
      "value": "65f1a2b3c4d5e6f7890a1c10",
      "type": "string"
    },
    {
      "key": "decisionNodeId",
      "value": "n_decision_1",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "🔐 Autenticación",
      "description": "Endpoints públicos y protegidos de autenticación",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@example.com\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Autentica usuario y devuelve accessToken/refreshToken junto a perfil."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "}",
                  "if (jsonData.refreshToken) {",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Registro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Carlos Lopez\",\n  \"email\": \"carlos@example.com\",\n  \"password\": \"SecurePass123\",\n  \"telefono\": \"+593999000111\",\n  \"departmentId\": \"65f1a2b3c4d5e6f7890a1b2d\",\n  \"role\": \"Disenador\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registra un nuevo usuario en el sistema."
          }
        },
        {
          "name": "Refrescar Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            },
            "description": "Renueva access token usando refresh token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "}",
                  "if (jsonData.refreshToken) {",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Cambiar Contraseña",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"OldPass123\",\n  \"newPassword\": \"NewSecurePass456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "change-password"]
            },
            "description": "Cambia la contraseña del usuario autenticado."
          }
        },
        {
          "name": "Cerrar Sesión",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Cierra la sesión del usuario autenticado."
          }
        }
      ]
    },
    {
      "name": "👥 Usuarios",
      "description": "Gestión de usuarios",
      "item": [
        {
          "name": "Listar Usuarios",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users?role=&activo=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                { "key": "role", "value": "", "description": "Filtrar por rol (opcional)" },
                { "key": "activo", "value": "", "description": "Filtrar por estado activo (opcional)" }
              ]
            },
            "description": "Lista todos los usuarios. Opcionalmente filtra por rol y estado activo."
          }
        }
      ]
    },
