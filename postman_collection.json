    {
      "name": "🔌 WebSocket (STOMP)",
      "description": "Endpoints WebSocket para edición colaborativa en tiempo real",
      "item": [
        {
          "name": "Conectar a Workflow",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"connect\",\n  \"workflowId\": \"{{workflowId}}\",\n  \"userId\": \"65f1a2b3c4d5e6f7890a1b2c\",\n  \"userName\": \"Ana Perez\"\n}"
            },
            "url": {
              "raw": "ws://localhost:8080/ws/workflow",
              "host": ["ws://localhost:8080"],
              "path": ["ws", "workflow"]
            },
            "description": "STOMP: /app/workflow/{workflowId}/connect - Registra editor activo y notifica a otros."
          }
        },
        {
          "name": "Desconectar de Workflow",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"disconnect\",\n  \"workflowId\": \"{{workflowId}}\",\n  \"userId\": \"65f1a2b3c4d5e6f7890a1b2c\",\n  \"userName\": \"Ana Perez\"\n}"
            },
            "url": {
              "raw": "ws://localhost:8080/ws/workflow",
              "host": ["ws://localhost:8080"],
              "path": ["ws", "workflow"]
            },
            "description": "STOMP: /app/workflow/{workflowId}/disconnect - Desconecta editor y notifica."
          }
        },
        {
          "name": "Suscribir a Cambios (topic)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "ws://localhost:8080/topic/workflow/{{workflowId}}",
              "host": ["ws://localhost:8080"],
              "path": ["topic", "workflow", "{{workflowId}}"]
            },
            "description": "STOMP subscribe: /topic/workflow/{workflowId} - Recibe broadcasts de cambios en tiempo real."
          }
        },
        {
          "name": "Suscribir a Estado de Edición (user queue)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "ws://localhost:8080/user/queue/editing-state",
              "host": ["ws://localhost:8080"],
              "path": ["user", "queue", "editing-state"]
            },
            "description": "STOMP subscribe: /user/queue/editing-state - Recibe estado de edición actual al conectarse."
          }
        }
      ]
    }
