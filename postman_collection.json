    },
    {
      "name": "⚙️ Workflows",
      "description": "Diseño y gestión de workflows",
      "item": [
        {
          "name": "Listar Workflows",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/workflows?estado=&nombre=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows"],
              "query": [
                { "key": "estado", "value": "", "description": "Filtrar por estado (opcional)" },
                { "key": "nombre", "value": "", "description": "Filtrar por nombre (opcional)" }
              ]
            },
            "description": "Lista todos los workflows con filtros opcionales."
          }
        },
        {
          "name": "Workflows Activos para Trámites",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/workflows/active-for-processes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows", "active-for-processes"]
            },
            "description": "Lista workflows activos para crear trámites. Roles: FUNCIONARIO, ADMIN."
          }
        },
        {
          "name": "Obtener Workflow por ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/workflows/{{workflowId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows", "{{workflowId}}"]
            },
            "description": "Obtiene el detalle completo de un workflow incluyendo lanes, nodos y edges."
          }
        },
        {
          "name": "Crear Workflow",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"WF-TRAM-002\",\n  \"nombre\": \"Licencias\",\n  \"descripcion\": \"Flujo de licencias\",\n  \"estado\": \"borrador\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/workflows",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows"]
            },
            "description": "Crea un nuevo workflow en estado borrador."
          }
        },
        {
          "name": "Actualizar Metadata del Workflow",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
            },
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Licencias v2\",\n  \"descripcion\": \"Actualización de metadata\",\n  \"estado\": \"activo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/workflows/{{workflowId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows", "{{workflowId}}"]
            },
            "description": "Actualiza nombre, descripción o estado de un workflow."
          }
        },
        {
          "name": "Guardar Diseño del Workflow",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
            },
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lanes\": [\n    {\n      \"id\": \"lane_finanzas\",\n      \"nombre\": \"Finanzas\",\n      \"descripcion\": \"Revisión financiera\",\n      \"responsable\": \"ROLE_FUNCIONARIO\",\n      \"color\": \"#3A86FF\",\n      \"departmentId\": \"65f1a2b3c4d5e6f7890a2a01\",\n      \"orden\": 1\n    }\n  ],\n  \"nodes\": [\n    {\n      \"id\": \"n_inicio\",\n      \"tipo\": \"inicio\",\n      \"nombre\": \"Inicio\",\n      \"descripcion\": \"Entrada del flujo\",\n      \"laneId\": \"lane_finanzas\",\n      \"departmentId\": \"65f1a2b3c4d5e6f7890a2a01\",\n      \"responsableTipo\": \"departamento\",\n      \"responsableUsuarioId\": null,\n      \"responsableRole\": \"Funcionario\",\n      \"slaMinutos\": 60,\n      \"permiteAdjuntos\": false,\n      \"form\": null,\n      \"reglasSalida\": [],\n      \"posicionX\": 150.5,\n      \"posicionY\": 120.0\n    }\n  ],\n  \"edges\": [\n    {\n      \"fromNodeId\": \"n_inicio\",\n      \"toNodeId\": \"n_fin\",\n      \"tipo\": \"secuencial\",\n      \"label\": \"continua\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/workflows/{{workflowId}}/design",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows", "{{workflowId}}", "design"]
            },
            "description": "Guarda el diseño completo del workflow: lanes, nodos y edges."
          }
        },
        {
          "name": "Validar Workflow",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
            },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/workflows/{{workflowId}}/validate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows", "{{workflowId}}", "validate"]
            },
            "description": "Valida la estructura del workflow. Retorna errores y advertencias."
          }
        },
        {
          "name": "Activar Workflow",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
            },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/workflows/{{workflowId}}/activate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows", "{{workflowId}}", "activate"]
            },
            "description": "Activa un workflow para que pueda ser usado en trámites."
          }
        },
        {
          "name": "Desactivar Workflow",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
            },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/workflows/{{workflowId}}/deactivate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows", "{{workflowId}}", "deactivate"]
            },
            "description": "Desactiva un workflow."
          }
        },
        {
          "name": "Eliminar Workflow (Lógico)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
            },
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/workflows/{{workflowId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows", "{{workflowId}}"]
            },
            "description": "Eliminación lógica del workflow (lo marca como inactivo)."
          }
        },
        {
          "name": "Tomar Lock del Workflow",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"65f1a2b3c4d5e6f7890a1b2c\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/workflows/{{workflowId}}/lock",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows", "{{workflowId}}", "lock"]
            },
            "description": "Bloquea el workflow para edición exclusiva."
          }
        },
        {
          "name": "Liberar Lock del Workflow",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
            },
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/workflows/{{workflowId}}/lock?userId=65f1a2b3c4d5e6f7890a1b2c",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows", "{{workflowId}}", "lock"],
              "query": [
                { "key": "userId", "value": "65f1a2b3c4d5e6f7890a1b2c" }
              ]
            },
            "description": "Libera el lock de edición del workflow."
          }
        },
        {
          "name": "Estado del Lock",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/workflows/{{workflowId}}/lock",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows", "{{workflowId}}", "lock"]
            },
            "description": "Obtiene el estado actual del lock del workflow."
          }
        }
      ]
    },
    {
      "name": "🔀 Reglas de Decisión",
      "description": "Gestión de reglas de decisión en nodos de tipo decisión",
      "item": [
        {
          "name": "Obtener Contexto de Decisión",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/workflows/{{workflowId}}/decision-context/{{decisionNodeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows", "{{workflowId}}", "decision-context", "{{decisionNodeId}}"]
            },
            "description": "Obtiene el contexto de decisión: campos disponibles, operadores por tipo."
          }
        },
        {
          "name": "Patch Reglas de Decisión",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
            },
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"binary\",\n  \"decisionRule\": {\n    \"field\": \"monto\",\n    \"operator\": \"GREATER_THAN\",\n    \"value\": \"1000\",\n    \"onTrueDestinoNodeId\": \"n_aprobado\",\n    \"onFalseDestinoNodeId\": \"n_rechazado\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/workflows/{{workflowId}}/nodes/{{decisionNodeId}}/decision-rules",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows", "{{workflowId}}", "nodes", "{{decisionNodeId}}", "decision-rules"]
            },
            "description": "Actualiza las reglas de decisión de un nodo."
          }
        },
        {
          "name": "Validar Reglas de Decisión",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"binary\",\n  \"decisionRule\": {\n    \"field\": \"monto\",\n    \"operator\": \"GREATER_THAN\",\n    \"value\": \"1000\",\n    \"onTrueDestinoNodeId\": \"n_aprobado\",\n    \"onFalseDestinoNodeId\": \"n_rechazado\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/workflows/{{workflowId}}/nodes/{{decisionNodeId}}/decision-rules/validate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows", "{{workflowId}}", "nodes", "{{decisionNodeId}}", "decision-rules", "validate"]
            },
            "description": "Valida las reglas de decisión sin guardarlas."
          }
        },
        {
          "name": "Simular Reglas de Decisión",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"binary\",\n  \"input\": {\n    \"aprobado\": true,\n    \"monto\": 1200\n  },\n  \"decisionRule\": {\n    \"field\": \"monto\",\n    \"operator\": \"GREATER_THAN\",\n    \"value\": \"1000\",\n    \"onTrueDestinoNodeId\": \"n_aprobado\",\n    \"onFalseDestinoNodeId\": \"n_rechazado\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/workflows/{{workflowId}}/nodes/{{decisionNodeId}}/decision-rules/simulate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workflows", "{{workflowId}}", "nodes", "{{decisionNodeId}}", "decision-rules", "simulate"]
            },
            "description": "Simula la evaluación de reglas de decisión con datos de entrada."
          }
        }
      ]
    },
